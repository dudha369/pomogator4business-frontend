{
  "name": "flow-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "node scripts/check-imports.mjs && tsc -b && prettier --check src && knip",
    "gen:types": "openapi-typescript https://raw.githubusercontent.com/dudha369/pomogator4business-backend/main/generated/openapi.json -o src/shared/api/generated/api-types.ts --default-non-nullable false",
    "gen:types:local": "openapi-typescript ../pomogator4business-backend/generated/openapi.json -o src/shared/api/generated/api-types.ts --default-non-nullable false"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tma.js/sdk-react": "^3.0.23",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "knip": "^6.45.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.5.4",
    "vite": "^8.3.0"
  }
}
